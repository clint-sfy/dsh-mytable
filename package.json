{
  "name": "dsh-mytable",
  "description": "工作台：DeepSeek Harness 标准插件包形式的 agent 级项目容器（侧边栏应用抽屉 + 分栏工作区 + 控制室 + DSH 设置里的开关清单）。状态存 localStorage dsh.mytable.* 与 IndexedDB dsh-mytable。",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test:gate": "node client-factory-gate.test.mjs",
    "test:anchor": "node tests/anchor-dom.test.mjs",
    "test:server": "node tests/server-home.test.mjs",
    "test:browser": "node tests/browser-policy.test.mjs",
    "test:reference": "node tests/reference-in-chat.test.mjs",
    "test:highlight": "node tests/code-highlight.test.mjs",
    "test:preview": "node tests/preview-families.test.mjs",
    "test:changes": "node tests/changes.test.mjs",
    "test:encoding": "node tests/encoding.test.mjs",
    "test:prompt-workspaces": "node --test tests/prompt-workspaces-model.test.mjs",
    "test": "npm run test:gate && npm run test:anchor && npm run test:server && npm run test:browser && npm run test:reference && npm run test:highlight && npm run test:preview && npm run test:changes && npm run test:encoding && npm run test:prompt-workspaces",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "xterm": "^5.3.0"
  },
  "dependencies": {
    "dsh-flowglass": "file:../dsh-flowglass/flowglass/dsh-flowglass-0.5.0.tgz"
  },
  "bundledDependencies": [
    "dsh-flowglass"
  ],
  "bundleDependencies": [
    "dsh-flowglass"
  ]
}
